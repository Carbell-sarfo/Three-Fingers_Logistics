---
import BrandLogo from '../components/BrandLogo.astro';
import '../styles/global.css'  

interface Props {
  title: string;
  mode?: 'mobile-auth' | 'rider' | 'admin';
  activeNav?: string;
}

const { title, mode = 'rider', activeNav = '' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#070d0a] text-slate-100 antialiased selection:bg-amber-500/30 selection:text-amber-200">
    <!-- Subtle ambient emerald & warm amber glow -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden -z-10">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[520px] h-[340px] rounded-full bg-amber-600/15 blur-[120px]"></div>
      <div class="absolute bottom-0 right-0 w-[420px] h-[320px] rounded-full bg-emerald-600/15 blur-[130px]"></div>
    </div>

    {mode === 'mobile-auth' ? (
      <main class="min-h-screen flex items-center justify-center p-4">
        <slot />
      </main>
    ) : mode === 'rider' ? (
      <div class="min-h-screen flex flex-col max-w-lg mx-auto px-4 pt-5 pb-24">
        <header class="flex items-center justify-between mb-6">
          <a href="/dashboard">
            <BrandLogo subtitle="Rider Portal" />
          </a>
          <div class="flex items-center gap-2">
            <a
              href="/statement"
              class="rounded-full bg-white/5 hover:bg-white/10 border border-white/10 px-3 py-1.5 text-xs font-medium text-emerald-200 transition"
            >
              Statement
            </a>
            <a
              href="/api/auth/logout?role=rider"
              class="rounded-full bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/25 px-3 py-1.5 text-xs font-medium text-rose-300 transition"
            >
              Logout
            </a>
          </div>
        </header>

        <main class="flex-1">
          <slot />
        </main>

        <!-- Bottom Mobile Nav -->
        <nav class="fixed bottom-4 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-md rounded-2xl bg-[#0e1b15]/95 backdrop-blur-md border border-white/10 px-3 py-2 flex items-center justify-around shadow-2xl">
          <a
            href="/dashboard"
            class:list={[
              'px-3.5 py-2 rounded-xl text-xs font-semibold transition',
              activeNav === 'dashboard' ? 'bg-emerald-500/20 text-emerald-300' : 'text-slate-400 hover:text-white',
            ]}
          >
            Home
          </a>
          <a
            href="/pay"
            class:list={[
              'px-4 py-2 rounded-xl text-xs font-bold transition',
              activeNav === 'pay'
                ? 'bg-gradient-to-r from-amber-500 to-orange-600 text-white shadow-md shadow-amber-900/50'
                : 'bg-amber-500/15 text-amber-300 hover:bg-amber-500/25',
            ]}
          >
            Pay Now
          </a>
          <a
            href="/statement"
            class:list={[
              'px-3.5 py-2 rounded-xl text-xs font-semibold transition',
              activeNav === 'statement' ? 'bg-emerald-500/20 text-emerald-300' : 'text-slate-400 hover:text-white',
            ]}
          >
            Ledger
          </a>
        </nav>
      </div>
    ) : (
      <div class="min-h-screen flex flex-col lg:flex-row">
        <!-- Sidebar (Emerald + Obsidian Dashboard Style) -->
        <aside class="w-full lg:w-64 bg-[#0b1712] border-b lg:border-b-0 lg:border-r border-white/10 p-4 lg:p-5 flex lg:flex-col justify-between gap-4">
          <div>
            <div class="flex items-center justify-between">
              <BrandLogo subtitle="Fleet Command" />
              <a
                href="/api/auth/logout?role=admin"
                class="lg:hidden rounded-xl bg-rose-500/10 border border-rose-500/25 px-3 py-1.5 text-xs font-semibold text-rose-300"
              >
                Logout
              </a>
            </div>

            <nav class="mt-6 flex lg:flex-col gap-1.5 overflow-x-auto pb-1">
              {[
                { href: '/admin', label: 'Overview', key: 'overview' },
                { href: '/admin/fleet', label: 'Fleet & Contracts', key: 'fleet' },
                { href: '/admin/riders', label: 'Riders & Strikes', key: 'riders' },
                { href: '/admin/pauses', label: 'Excused Pauses', key: 'pauses' },
              ].map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'px-3.5 py-2.5 rounded-xl text-sm font-medium whitespace-nowrap transition',
                    activeNav === item.key
                      ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
                      : 'text-slate-400 hover:text-white hover:bg-white/5',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </div>

          <div class="hidden lg:flex flex-col gap-3">
            <div class="rounded-xl bg-white/[0.03] border border-white/10 p-3 text-xs text-slate-400">
              <div class="text-emerald-300 font-semibold">Monday Cycle</div>
              <div class="mt-0.5">Lease Min: GHS 500 • Sales Min: GHS 300</div>
            </div>

            <a
              href="/api/auth/logout?role=admin"
              class="w-full text-center rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/25 py-2.5 text-xs font-semibold text-rose-300 transition"
            >
              Sign Out
            </a>
          </div>
        </aside>

        <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto">
          <slot />
        </main>
      </div>
    )}
  </body>
</html>