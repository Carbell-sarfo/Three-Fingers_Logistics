---
import AppLayout from '../../layouts/AppLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';

const [{ data: bikes }, { data: riders }, { data: contracts }, { data: payments }, { data: loans }, { data: loanPayments }] =
  await Promise.all([
    supabaseAdmin.from('bikes').select('*'),
    supabaseAdmin.from('riders').select('*'),
    supabaseAdmin.from('contracts').select('*, riders(full_name, phone)'),
    supabaseAdmin.from('payments').select('*').eq('verification_status', 'Verified').order('paid_at', { ascending: false }),
    supabaseAdmin.from('company_loans').select('*'),
    supabaseAdmin.from('loan_payments').select('*'),
  ]);

const bikeList = bikes || [];
const riderList = riders || [];
const contractList = contracts || [];
const paymentList = payments || [];
const loanList = loans || [];
const loanPaymentList = loanPayments || [];

const activeBikes = bikeList.filter((b) => b.status === 'On Lease').length;
const activeRiders = riderList.filter((r) => r.status === 'Active').length;
const totalCollected = paymentList.reduce((s, p) => s + Number(p.amount), 0);
const fleetCost = bikeList.filter((b) => b.status !== 'Repossessed').reduce((s, b) => s + Number(b.purchase_cost || 0), 0);

const totalContractValue = contractList
  .filter((c) => c.contract_type === 'lease_to_own')
  .reduce((s, c) => s + Number(c.contract_value || 0), 0);

const totalDepositsHeld = contractList
  .filter((c) => c.deposit_status === 'Paid' && c.status !== 'Completed')
  .reduce((s, c) => s + Number(c.security_deposit || 0), 0);

const totalOutstanding = Math.max(0, totalContractValue - totalCollected - totalDepositsHeld);

const totalLoanPrincipal = loanList.reduce((s, l) => s + Number(l.loan_amount || 0), 0);
const totalLoanPaid = loanPaymentList.reduce((s, lp) => s + Number(lp.amount || 0), 0);
const loanBalance = Math.max(0, totalLoanPrincipal - totalLoanPaid);

// 2-Week Deposit Buffer Repo Alerts (arrears >= security_deposit or status === 'At Risk')
const repoAlerts = contractList.filter(
  (c) => c.status === 'At Risk' || Number(c.arrears_balance || 0) >= Number(c.security_deposit || 0)
);

// Underpayment Strike Watch (strikes > 0 or arrears > 0)
const strikeWatch = contractList.filter(
  (c) => Number(c.underpayment_strikes || 0) > 0 || Number(c.arrears_balance || 0) > 0
);
---

<AppLayout title="Admin Overview — Three Fingers Transport" mode="admin" activeNav="overview">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <div>
      <p class="text-xs uppercase tracking-wider text-emerald-400 font-semibold">Three Fingers Ltd.</p>
      <h1 class="text-2xl font-bold text-white mt-0.5">Fleet & Collections Overview</h1>
    </div>
    <div class="text-xs text-slate-400">
      As of {new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' })}
    </div>
  </div>

  <!-- 2-Week Repo Alert Banner -->
  {repoAlerts.length > 0 && (
    <div class="mb-6 rounded-2xl bg-rose-950/60 border border-rose-500/40 p-4">
      <div class="text-sm font-bold text-rose-300">
        Repo Alert ({repoAlerts.length}) — 2-Week Deposit Buffer Exhausted
      </div>
      <div class="mt-2 space-y-1.5 text-xs text-rose-100">
        {repoAlerts.map((c: any) => (
          <div class="flex items-center justify-between bg-black/20 rounded-xl px-3 py-2">
            <span>
              <strong>{c.riders?.full_name || c.rider_id}</strong> ({c.bike_id}) — Arrears: <strong>GHS {Number(c.arrears_balance).toLocaleString()}</strong> / Deposit: GHS {Number(c.security_deposit).toLocaleString()}
            </span>
            <span class="rounded-full bg-rose-500/20 text-rose-200 px-2.5 py-0.5 font-semibold">Retrieve Bike</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Primary KPI Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
    <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-5">
      <div class="text-xs text-slate-400">Active Bikes / Riders</div>
      <div class="text-2xl font-extrabold text-white mt-1.5">
        {activeBikes} <span class="text-sm font-normal text-slate-400">/ {activeRiders} riders</span>
      </div>
      <div class="text-xs text-emerald-400 mt-2">Fleet Cost: GHS {fleetCost.toLocaleString()}</div>
    </div>

    <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-5">
      <div class="text-xs text-slate-400">Total Collected (Verified)</div>
      <div class="text-2xl font-extrabold text-emerald-300 mt-1.5">
        GHS {totalCollected.toLocaleString()}
      </div>
      <div class="text-xs text-slate-400 mt-2">{paymentList.length} total receipts</div>
    </div>

    <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-5">
      <div class="text-xs text-slate-400">Lease Balance Remaining</div>
      <div class="text-2xl font-extrabold text-white mt-1.5">
        GHS {totalOutstanding.toLocaleString()}
      </div>
      <div class="text-xs text-amber-300 mt-2">Deposits Held: GHS {totalDepositsHeld.toLocaleString()}</div>
    </div>

    <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-5">
      <div class="text-xs text-slate-400">Company Loan Balance</div>
      <div class="text-2xl font-extrabold text-amber-300 mt-1.5">
        GHS {loanBalance.toLocaleString()}
      </div>
      <div class="text-xs text-slate-400 mt-2">Paid: GHS {totalLoanPaid.toLocaleString()}</div>
    </div>
  </div>

  <!-- Strike Watch & Recent Payments -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Underpayment Strike Watch -->
    <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-5">
      <h2 class="text-base font-bold text-white mb-3">Underpayment & Arrears Watch</h2>
      {strikeWatch.length === 0 ? (
        <p class="text-xs text-slate-400 py-6 text-center">
          No riders with carried-forward arrears or underpayment strikes right now.
        </p>
      ) : (
        <div class="divide-y divide-white/5">
          {strikeWatch.map((c: any) => (
            <div class="py-3 flex items-center justify-between text-xs">
              <div>
                <div class="font-semibold text-white">{c.riders?.full_name || c.rider_id}</div>
                <div class="text-slate-400">
                  {c.contract_type === 'lease_to_own' ? 'Lease-to-Own' : 'Sales'} • Arrears: GHS {Number(c.arrears_balance).toLocaleString()}
                </div>
              </div>
              <span class="rounded-full bg-amber-500/15 border border-amber-400/30 text-amber-300 px-3 py-1 font-semibold">
                Strikes: {c.underpayment_strikes} / 3
              </span>
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- Recent Payments Ledger -->
    <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-5">
      <h2 class="text-base font-bold text-white mb-3">Recent Verified Payments</h2>
      <div class="divide-y divide-white/5">
        {paymentList.slice(0, 8).map((p: any) => (
          <div class="py-2.5 flex items-center justify-between text-xs">
            <div>
              <div class="font-semibold text-white">
                {p.receipt_number} • {p.rider_id} (Wk {p.week_number})
              </div>
              <div class="text-slate-400">
                {new Date(p.paid_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })} • {p.payment_method}
              </div>
            </div>
            <div class="text-right">
              <div class="font-bold text-emerald-300">GHS {Number(p.amount).toLocaleString()}</div>
              <a href={`/api/pdf/receipt/${p.receipt_number}`} class="text-[11px] text-amber-300 hover:underline">
                PDF
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</AppLayout>