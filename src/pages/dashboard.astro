---
import AppLayout from '../layouts/AppLayout.astro';
import { supabaseAdmin } from '../lib/supabase';

const riderId = Astro.locals.riderId!;

const { data: rider } = await supabaseAdmin
  .from('riders')
  .select('*')
  .eq('id', riderId)
  .single();

const { data: contract } = await supabaseAdmin
  .from('contracts')
  .select('*, bikes(registration_number, status)')
  .eq('rider_id', riderId)
  .order('created_at', { ascending: false })
  .limit(1)
  .maybeSingle();

const { data: payments } = await supabaseAdmin
  .from('payments')
  .select('*')
  .eq('rider_id', riderId)
  .eq('verification_status', 'Verified')
  .order('week_number', { ascending: false });

const totalPaid = (payments || []).reduce((sum, p) => sum + Number(p.amount), 0);
const isLease = contract?.contract_type === 'lease_to_own';
const depositCredit = contract?.deposit_status === 'Paid' ? Number(contract.security_deposit) : 0;
const remainingBalance =
  contract && isLease
    ? Math.max(0, Number(contract.contract_value) - totalPaid - depositCredit)
    : 0;
const progressPct =
  contract && isLease && Number(contract.contract_value) > 0
    ? Math.min(100, Math.round(((totalPaid + depositCredit) / Number(contract.contract_value)) * 100))
    : 0;

const arrears = Number(contract?.arrears_balance || 0);
const strikes = Number(contract?.underpayment_strikes || 0);
const depositAmount = Number(contract?.security_deposit || (isLease ? 1000 : 600));
const depositRemaining = Math.max(0, depositAmount - arrears);
---

<AppLayout title="My Dashboard — Three Fingers Transport" mode="rider" activeNav="dashboard">
  <!-- Greeting & Bike Pill -->
  <div class="flex items-center justify-between gap-3 mb-5">
    <div>
      <p class="text-xs text-emerald-300/80 font-medium">Welcome back</p>
      <h1 class="text-xl font-bold text-white">{rider?.full_name}</h1>
    </div>
    {contract && (
      <span class="rounded-full bg-emerald-500/15 border border-emerald-400/30 px-3 py-1 text-xs font-semibold text-emerald-300">
        {contract.bike_id} • {isLease ? 'Lease-to-Own' : 'Sales'}
      </span>
    )}
  </div>

  <!-- 2-Week Repo / Strike Warnings -->
  {contract?.status === 'At Risk' && (
    <div class="mb-4 rounded-2xl bg-rose-950/70 border border-rose-500/40 p-4 text-xs text-rose-200">
      <div class="font-bold text-rose-300 text-sm mb-0.5">Repo Alert: 2-Week Deposit Buffer Reached</div>
      Your unpaid arrears (GHS {arrears.toLocaleString()}) have reached your GHS {depositAmount.toLocaleString()} security deposit. Please settle immediately or contact Three Fingers Transport.
    </div>
  )}

  {strikes > 0 && (
    <div class="mb-4 rounded-2xl bg-amber-950/60 border border-amber-500/35 p-4 text-xs text-amber-200">
      <div class="font-bold text-amber-300 mb-0.5">Underpayment Strike {strikes} of 3</div>
      Carried-forward arrears: <span class="font-semibold">GHS {arrears.toLocaleString()}</span>.
      {strikes >= 3
        ? ' Partial payments below your weekly minimum are locked until arrears are cleared or 4 full on-time weeks are completed.'
        : ' Strikes reset automatically when arrears are cleared or after 4 consecutive full weekly payments.'}
    </div>
  )}

  {contract ? (
    <>
      <!-- Primary Hero Card -->
      <div class="rounded-3xl bg-gradient-to-br from-[#132a20] via-[#0e1b15] to-[#1d1209] border border-white/10 p-5 mb-4 shadow-xl">
        <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
          <span>{isLease ? 'Remaining Lease Balance' : 'Weekly Sales Minimum'}</span>
          <span class="text-amber-300 font-semibold">
            Min: GHS {Number(contract.weekly_minimum).toLocaleString()} / Mon
          </span>
        </div>
        <div class="text-3xl font-extrabold text-white tracking-tight">
          GHS {isLease ? remainingBalance.toLocaleString() : Number(contract.weekly_minimum).toLocaleString()}
        </div>

        {isLease && (
          <div class="mt-4">
            <div class="flex justify-between text-xs mb-1.5">
              <span class="text-slate-400">Completion Progress</span>
              <span class="text-emerald-300 font-semibold">{progressPct}%</span>
            </div>
            <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden">
              <div
                class="h-full rounded-full bg-gradient-to-r from-emerald-400 to-amber-400"
                style={`width: ${progressPct}%`}
              ></div>
            </div>
          </div>
        )}

        <div class="mt-5">
          <a
            href="/pay"
            class="block w-full text-center rounded-full bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-white font-bold py-3 text-sm shadow-lg shadow-amber-950/60 transition"
          >
            Make Weekly Payment
          </a>
        </div>
      </div>

      <!-- 2x2 Metric Grid (Dashboard Card Style) -->
      <div class="grid grid-cols-2 gap-3 mb-6">
        <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-4">
          <div class="text-[11px] text-slate-400">Total Paid</div>
          <div class="text-lg font-bold text-white mt-1">GHS {totalPaid.toLocaleString()}</div>
          <div class="text-[11px] text-emerald-400 mt-1">{(payments || []).length} payments</div>
        </div>

        <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-4">
          <div class="text-[11px] text-slate-400">Deposit Buffer</div>
          <div class="text-lg font-bold text-white mt-1">GHS {depositRemaining.toLocaleString()}</div>
          <div class="text-[11px] text-slate-400 mt-1">of GHS {depositAmount.toLocaleString()}</div>
        </div>

        <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-4">
          <div class="text-[11px] text-slate-400">Arrears Carried</div>
          <div class="text-lg font-bold text-white mt-1">GHS {arrears.toLocaleString()}</div>
          <div class="text-[11px] text-slate-400 mt-1">2 wks = repo alert</div>
        </div>

        <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-4">
          <div class="text-[11px] text-slate-400">Underpay Strikes</div>
          <div class="text-lg font-bold text-white mt-1">{strikes} / 3</div>
          <div class="text-[11px] text-slate-400 mt-1">Streak: {contract.consecutive_full_weeks}/4 wks</div>
        </div>
      </div>

      <!-- Recent Payments & Receipts -->
      <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-4">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-sm font-bold text-white">Recent Receipts</h2>
          <a href="/statement" class="text-xs text-amber-300 hover:underline">Full Statement</a>
        </div>

        <div class="divide-y divide-white/5">
          {(payments || []).slice(0, 5).map((p) => (
            <div class="py-3 flex items-center justify-between gap-2">
              <div>
                <div class="text-xs font-semibold text-white">
                  {p.receipt_number} • Week {p.week_number}
                </div>
                <div class="text-[11px] text-slate-400">
                  {new Date(p.paid_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })} • {p.payment_method}
                </div>
              </div>
              <div class="text-right">
                <div class="text-xs font-bold text-emerald-300">GHS {Number(p.amount).toLocaleString()}</div>
                <a
                  href={`/api/pdf/receipt/${p.receipt_number}`}
                  class="text-[11px] text-amber-300 hover:underline"
                >
                  Download PDF
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </>
  ) : (
    <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-6 text-center text-sm text-slate-400">
      No active contract assigned to your profile yet.
    </div>
  )}
</AppLayout>