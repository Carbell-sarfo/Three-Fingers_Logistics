---
import AppLayout from '../layouts/AppLayout.astro';
import { supabaseAdmin } from '../lib/supabase';

const riderId = Astro.locals.riderId!;

const [{ data: rider }, { data: contract }, { data: payments }] = await Promise.all([
  supabaseAdmin.from('riders').select('*').eq('id', riderId).single(),
  supabaseAdmin.from('contracts').select('*').eq('rider_id', riderId).order('created_at', { ascending: false }).limit(1).maybeSingle(),
  supabaseAdmin.from('payments').select('*').eq('rider_id', riderId).eq('verification_status', 'Verified').order('week_number', { ascending: false }),
]);

const list = payments || [];
const totalPaid = list.reduce((s, p) => s + Number(p.amount), 0);
const isLease = contract?.contract_type === 'lease_to_own';
const depCredit = contract?.deposit_status === 'Paid' ? Number(contract.security_deposit) : 0;
const remaining = contract && isLease ? Math.max(0, Number(contract.contract_value) - totalPaid - depCredit) : 0;
---

<AppLayout title="Statement of Affairs — Three Fingers Transport" mode="rider" activeNav="statement">
  <div class="flex items-center justify-between gap-3 mb-5">
    <div>
      <h1 class="text-xl font-bold text-white">Statement of Affairs</h1>
      <p class="text-xs text-slate-400">{rider?.full_name} • {contract?.contract_id || contract?.id}</p>
    </div>
    <a
      href={`/api/pdf/statement/${riderId}`}
      class="rounded-full bg-gradient-to-r from-amber-500 to-orange-600 px-4 py-2 text-xs font-bold text-white shadow-md"
    >
      Download PDF
    </a>
  </div>

  {contract && (
    <div class="rounded-2xl bg-[#0e1b15] border border-white/10 p-4 mb-5 space-y-2 text-xs">
      <div class="flex justify-between">
        <span class="text-slate-400">Contract Type</span>
        <span class="font-semibold text-white">{isLease ? 'Lease-to-Own' : 'Pure Sales'}</span>
      </div>
      {isLease && (
        <div class="flex justify-between">
          <span class="text-slate-400">Contract Value</span>
          <span class="font-semibold text-white">GHS {Number(contract.contract_value).toLocaleString()}</span>
        </div>
      )}
      <div class="flex justify-between">
        <span class="text-slate-400">Security Deposit ({contract.deposit_status})</span>
        <span class="font-semibold text-white">GHS {Number(contract.security_deposit).toLocaleString()}</span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Total Installments Paid</span>
        <span class="font-semibold text-emerald-300">GHS {totalPaid.toLocaleString()}</span>
      </div>
      {isLease && (
        <div class="flex justify-between pt-2 border-t border-white/10">
          <span class="text-slate-300 font-medium">Outstanding Balance</span>
          <span class="font-bold text-amber-300 text-sm">GHS {remaining.toLocaleString()}</span>
        </div>
      )}
    </div>
  )}

  <div class="rounded-2xl bg-[#0e1b15] border border-white/10 overflow-hidden">
    <div class="px-4 py-3 border-b border-white/10 text-xs font-bold text-white">
      All Verified Payments ({list.length})
    </div>
    <div class="divide-y divide-white/5">
      {list.map((p) => (
        <div class="px-4 py-3 flex items-center justify-between text-xs">
          <div>
            <div class="font-semibold text-white">{p.receipt_number} • Week {p.week_number}</div>
            <div class="text-[11px] text-slate-400">
              {new Date(p.paid_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })} • {p.payment_method}
              {p.reference_number ? ` • Ref: ${p.reference_number}` : ''}
            </div>
          </div>
          <div class="text-right">
            <div class="font-bold text-emerald-300">GHS {Number(p.amount).toLocaleString()}</div>
            <a href={`/api/pdf/receipt/${p.receipt_number}`} class="text-[11px] text-amber-300 hover:underline">
              PDF
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</AppLayout>